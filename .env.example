# Agent B (Streaming Discovery Agent). Copy to .env and fill in. Never commit .env.

# Model (ADR-003: Groq through the OpenAI Agents SDK). Use a key separate from Agent A's.
GROQ_API_KEY=
GROQ_MODEL=
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# A2A server. Until Phase 5 (authentication) Agent B listens on 127.0.0.1 only.
# DISCOVERY_PORT=8010

# The SDK's built-in tracing exports to OpenAI's servers: keep it off (ADR-003).
OPENAI_AGENTS_DISABLE_TRACING=1

# Catalog (moved from Agent A in Phase 2). Title lookups need it; YouTube search does not.
RAPIDAPI_KEY=
# Optional tuning (defaults as in Agent A):
# CATALOG_CACHE_TTL=86400
# CATALOG_STALE_MAX=604800
# CATALOG_RETRIES=3
# CATALOG_BACKOFF=0.5
# CATALOG_BREAKER_FAILURES=3
# CATALOG_BREAKER_RESET=60
# CATALOG_CALL_TIMEOUT=60
