{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:streamwise:access:1",
  "title": "Agent B caller policy (config/access.json)",
  "type": "object",
  "required": ["version", "required_scope", "callers"],
  "additionalProperties": false,
  "properties": {
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "description": {"type": "string"},
    "required_scope": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,60}$"},
    "callers": {
      "type": "object", "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9-]{1,60}$"},
      "additionalProperties": {
        "type": "object", "required": ["operations", "permissions", "rate_limit"], "additionalProperties": false,
        "properties": {
          "operations": {"type": "array", "minItems": 1, "uniqueItems": true,
                         "items": {"enum": ["lookup_title", "lookup_titles", "search_youtube", "discover"]}},
          "permissions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z]+:[a-z]+$"}},
          "rate_limit": {
            "type": "object", "required": ["requests_per_minute", "discover_per_minute"], "additionalProperties": false,
            "properties": {"requests_per_minute": {"type": "integer", "minimum": 1, "maximum": 10000},
                           "discover_per_minute": {"type": "integer", "minimum": 0, "maximum": 1000}}
          }
        }
      }
    }
  }
}
